<brls:AppletFrame
    title="SwitchLive">

    <brls:Box
        width="match_parent"
        height="match_parent"
        flexDirection="column"
        padding="20">

        <brls:Label
            id="main/title"
            width="match_parent"
            height="40"
            fontSize="24"
            text="SwitchLive"/>

        <brls:Label
            id="main/status"
            width="match_parent"
            height="30"
            fontSize="16"
            marginTop="5"
            text="Select a platform"/>

        <brls:ScrollingFrame
            id="main/categories"
            width="match_parent"
            height="match_parent"
            marginTop="15"
            flexDirection="column"
            padding="10"/>

    </brls:Box>

</brls:AppletFrame>
